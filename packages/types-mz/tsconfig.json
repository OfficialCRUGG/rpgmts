{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "lib": ["ES2022"],

    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,

    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "declaration": true,
    "sourceMap": true,

    "rootDir": "types",

    "skipLibCheck": true
  },
  "include": ["types/**/*.d.ts"]
}
